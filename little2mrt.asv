
clc; clear; close all

% input tables, "handwritten" 
Tg = readtable('table gdp per country by hand .xlsx');          % col: Country, Year, GDP
Te = readtable('table emigration per country by hand .xlsx');   % col: Country, Year, EmigRate

%name variable minusc
normalise_c = @(s) lower(strtrim(string(s)));

Tg.Country = norm(Tg.Country);  Te.Country = norm(Te.Country);
% same columns present  --> implementation needed : fill holes with
% regression when one year is missing 
T = innerjoin(Tg, Te, "Keys", {'Country','Year'}); 


function beta = fit_one(Tc)
    x1 = log(Tc.GDP(:));
    x2 = double(Tc.Year(:));   
    X  = [ones(size(x1)) x1 x2];
    y  = Tc.EmigrationRate(:);
    beta = X \ y;              % [a_c; b_c; g_c]
end

% estime
countries = unique(T.Country);
coef = containers.Map('KeyType','char','ValueType','any');
for i = 1:numel(countries)
    c = countries(i);
    Tc = T(T.Country==c, :);
    if height(Tc) >= 3        % minimo ragionevole
        coef(char(c)) = fit_one(Tc);
    end
end

% "estime"moyenne si il y a pas assez de donnes , on utilise ce resultat 
x1 = log(T.GDP(:));
x2 = double(T.Year(:));
Xpooled = [ones(size(x1)) x1 x2];
b_pooled = Xpooled \ T.EmigrationRate(:);   % [a; b; g]

% inputs country, year 
country_in = input('Inserisci paese: ');
year_in    = input('Inserisci anno (es. 2010): ');

key = norm(country_in);

% GDP del paese/anno richiesto (deve esistere nella tabella GDP)
rowGDP = Tg(Tg.Country==key & Tg.Year==year_in, :);
if isempty(rowGDP); error('GDP non disponibile per il paese/anno richiesto.'); end
g = rowGDP.GDP(1);


if isKey(coef, key)
    b = coef(key);
else
    b = b_pooled;
end

% predict
y_hat = b(1) + b(2)*log(g) + b(3)*double(year_in);
fprintf('Stima emigrazione %s-%d: %.6g (unità come nei dati)\n', country_in, year_in, y_hat);

% compute the 3 lines and chechk if it can predict the 4 well enough. RMSE
% small = good, big = bad 
R = [];
for i = 1:numel(countries)
    c = countries(i);
    Tc = T(T.Country==c, :);
    if height(Tc) < 4, continue; end
    % usa tutti gli anni tranne l'ultimo per fit e predici l'ultimo
    Tc = sortrows(Tc,'Year');
    Tr = Tc(1:end-1,:); Te1 = Tc(end,:);
    b_c = fit_one(Tr);
    y_pred = b_c(1) + b_c(2)*log(Te1.GDP) + b_c(3)*double(Te1.Year);
    R(end+1,1) = y_pred - Te1.EmigrationRate; %#ok<SAGROW>
end
if ~isempty(R)
    rmse = sqrt(mean(R.^2));
    fprintf('RMSE holdout per-country (ultimo anno escluso): %.4g\n', rmse);
end

% --- Visualizzazione dei risultati ---
figure;
bar(countries, cell2mat(values(coef)), 'FaceColor', [0.2 0.6 0.8]);
xlabel('Paesi');
ylabel('Coefficienti di Emigrazione');
title('Coefficienti di Emigrazione per Paese');
grid on;