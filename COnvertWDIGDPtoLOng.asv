clc; clear; close all

T = readtable('gdp.csv','Delimiter',';')
idx = strcmp(T.("Indicator Name"),"GDP per capita (current US$)");
G = T(idx,:);

cols = string(G.Properties.VariableNames);
cols = cols(startsWith(cols,"19") | startsWith(cols,"20"));

Country = G.("Country Name"){1};
out = [];

for k = 1:numel(cols)
    y = str2double(cols(k));
    v = G.(cols(k));
    if ~isnan(v)
        out = [out; {Country, y, v}];
    end
end

OUT = cell2table(out,"VariableNames",{'Country','Year','GDP'});
writetable(OUT,'GDP_long.txt','Delimiter','\t');
